# Database
DATABASE_URL="mysql://root:@localhost:3306/susu_db"  # Use XAMPP MySQL when running backend locally
# For Docker on Windows/XAMPP, use:
# DATABASE_URL="mysql://root:@host.docker.internal:3306/susu_db"

# Korapay Payment Gateway
KORAPAY_BASE_URL="https://api.korapay.com/merchant/api/v1"
KORAPAY_SECRET_KEY="your-korapay-secret-key"
KORAPAY_WEBHOOK_SECRET="your-korapay-webhook-secret"
KORAPAY_WEBHOOK_URL="https://yourdomain.com/api/webhooks/korapay"

# Africa's Talking (SMS)
AT_API_KEY="your-africastalking-api-key"
AT_USERNAME="your-username"
AT_SMS_FROM="SUSU"

# Redis (for BullMQ)
REDIS_URL="redis://localhost:6379"

# App
PORT=3000
NODE_ENV=development
APP_URL="https://yourdomain.com"
CRON_DEBIT_TIME="0 8 * * *"

# Commission
COMMISSION_DAYS=1
MAX_RETRY_ATTEMPTS=3
GRACE_PERIOD_DAYS=2
MAX_FAILURES=5
